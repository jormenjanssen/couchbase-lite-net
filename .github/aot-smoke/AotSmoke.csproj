<Project Sdk="Microsoft.NET.Sdk">
  <!-- Native AOT smoke test for the aot/4.1.2 packages. Built by .github/workflows/aot-package.yml against the
       freshly packed nupkgs; any IL trim/AOT warning fails the workflow. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- The whole point: Couchbase Lite must work without reflection-based System.Text.Json. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <CblVersion Condition="'$(CblVersion)' == ''">4.1.2-aot.0-local</CblVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Couchbase.Lite" Version="[$(CblVersion)]" />
  </ItemGroup>
</Project>
